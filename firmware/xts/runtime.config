CONFIG_NET_TCP_NWRBCHAINS=8
CONFIG_NET_TCP_ALLOC_WRBCHAINS=1
CONFIG_NET_TCPBACKLOG=y
CONFIG_NET_TCPBACKLOG_CONNS=8
